        ]
      }
    }
  ],
  "steps": [
    {
      "module": "General",
      "items": [
        {
          "id": "sg-ge-clean",
          "text": "Do the weekly cleaning: brewer, mixing chamber and the rest. Wipe the machine down inside and out.",
          "ref": "Bravilor Sego 12 PM sheet"
        },
        {
          "id": "sg-ge-inspect",
          "text": "Inspect every part for damage, wear and leaks.",
          "ref": "Bravilor Sego 12 PM sheet"
        }
      ]
    },
    {
      "module": "Descaling",
      "items": [
        {
          "id": "sg-de-run",
          "text": "Descale from Setup > Maintenance > Descaling (about 60 min, don't leave it). One Renegite packet in 17 fl oz of 140 °F water.",
          "ref": "Sego descaling guide"
        },
        {
          "id": "sg-de-selector",
          "text": "Remove and take apart the water selector. Clean off scale, grease the drive auger and rotating disc with food-grade grease, refit.",
          "ref": "Bravilor Sego 12 PM sheet"
        },
        {
          "id": "sg-de-reservoir",
          "text": "Take out the cold water reservoir. Check the float and pump for damage, dirt, wear and scale. Refit.",
          "ref": "Bravilor Sego 12 PM sheet"
        },
        {
          "id": "sg-de-reminder",
          "text": "Set the descale reminder for the water hardness (Process settings > Descale management).",
          "ref": "Bravilor Sego 12 PM sheet"
        }
      ]
    },
    {
      "module": "Brewer (CIRCO)",
      "items": [
        {
          "id": "sg-br-set",
          "text": "Remove the CIRCO brewer, replace every part in the brewer service set, grease the large O-ring, refit and test.",
          "ref": "Bravilor Sego 12 PM sheet"
        }
      ]
    },
    {
      "module": "Mixing system",
      "items": [
        {
          "id": "sg-mx-seals",
          "text": "Remove the mixing bowl. Replace both mixer seals, the holder seal and the water inlet O-ring.",
          "ref": "Bravilor Sego 12 PM sheet"
        },
        {
          "id": "sg-mx-shaft",
          "text": "Check and clean the mixer motor shaft. Refit and check for leaks.",
          "ref": "Bravilor Sego 12 PM sheet"
        }
      ]
    },
    {
      "module": "Grinder",
      "items": [
        {
          "id": "sg-gr-empty",
          "text": "Empty and clean the bean canister. Vacuum or run out the beans left in the grinder.",
          "ref": "Bravilor Sego 12 PM sheet"
        },
        {
          "id": "sg-gr-burrs",
          "text": "Check the grinder burrs for wear. Replace if worn (6.331.433.001).",
          "ref": "Bravilor Sego 12 PM sheet"
        },
        {
          "id": "sg-gr-cal",
          "text": "Refill beans and calibrate the grinders: Setup > Service > Calibration (gram scale).",
          "ref": "Bravilor Sego 12 PM sheet"
        }
      ]
    },
    {
      "module": "Close out",
      "items": [
        {
          "id": "sg-co-test",
          "text": "Dispense several drinks and check the machine works properly.",
          "ref": "Bravilor Sego 12 PM sheet"
        }
      ]
    }
  ],
