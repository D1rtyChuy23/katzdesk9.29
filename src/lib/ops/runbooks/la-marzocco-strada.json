  "steps": [
    {
      "module": "Water quality",
      "items": [
        {
          "id": "wq-test",
          "text": "Test the water before and after the filter with the LM test kit (F.9.000.01). Record the filter make and type and compare with the limits in Reference.",
          "ref": "LM checklist"
        }
      ]
    },
    {
      "module": "Group heads",
      "items": [
        {
          "id": "st-gh-replace",
          "text": "Replace the diffuser screens and group gaskets on every group.",
          "when": {
            "pm": [
              "3"
            ]
          },
          "ref": "LM 3/9-mo checklist"
        },
        {
          "id": "st-gh-kit",
          "text": "Fit the parts in the PM kit.",
          "when": {
            "pm": [
              "6",
              "12"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-baskets",
          "text": "Check the filter baskets and springs.",
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-flush",
          "text": "Confirm the auto flush system works.",
          "when": {
            "model": [
              "x"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-jaw",
          "text": "Check the portafilter jaw bushings.",
          "when": {
            "pm": [
              "3",
              "6"
            ],
            "model": [
              "x"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-piston",
          "text": "Check the Straight-In piston for leaks under pressure.",
          "when": {
            "model": [
              "x"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-micro",
          "text": "Check the group cap micro switches.",
          "when": {
            "pm": [
              "6",
              "12"
            ],
            "model": [
              "x"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-buttons",
          "text": "Test every button.",
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-res",
          "text": "Measure each flow meter's field resistance: 2.2 kΩ ±10% (1.98–2.42 kΩ). Record G1–G3 in kΩ.",
          "ref": "LM checklist"
        },
        {
          "id": "st-gh-imp",
          "text": "Check the flow meter impellers.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "x"
            ]
          },
          "ref": "LM 12-mo checklist"
        },
        {
          "id": "st-gh-flow",
          "text": "Record each group's flow rate (Strada X: in AV mode): grams in 30 s, G1–G3.",
          "ref": "LM checklist"
        }
      ]
    },
    {
      "module": "Pressure and pumps",
      "items": [
        {
          "id": "st-pr-press",
          "text": "Record the brewing pressure (bar). Strada X: each group.",
          "ref": "LM checklist"
        },
        {
          "id": "st-pr-exp",
          "text": "Check the expansion valves and record the maximum pressure (bar). Strada X: each group.",
          "ref": "LM checklist"
        },
        {
          "id": "st-pr-gear",
          "text": "Check the gear pumps for leaks.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "x"
            ]
          },
          "ref": "LM 12-mo checklist"
        }
      ]
    },
    {
      "module": "Steam",
      "items": [
        {
          "id": "st-st-valve",
          "text": "Check the steam valves work.",
          "ref": "LM checklist"
        }
      ]
    },
    {
      "module": "Water and drain",
      "items": [
        {
          "id": "st-wd-probe",
          "text": "Clean the auto-fill probe.",
          "ref": "LM checklist"
        },
        {
          "id": "st-wd-leaks",
          "text": "Check all fittings and valves for leaks.",
          "ref": "LM checklist"
        },
        {
          "id": "st-wd-vb",
          "text": "Check the vacuum breakers work.",
          "when": {
            "pm": [
              "3",
              "6"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-wd-sensor",
          "text": "Check the water sensor for leaks.",
          "ref": "LM checklist"
        },
        {
          "id": "st-wd-lines",
          "text": "Check the water and drain lines, drain box and hose for leaks or clogs.",
          "ref": "LM checklist"
        }
      ]
    },
    {
      "module": "Electrical",
      "items": [
        {
          "id": "st-el-cord",
          "text": "Check the power cord, cap and outlet.",
          "ref": "LM checklist"
        },
        {
          "id": "st-el-harness",
          "text": "Check the wiring harness and components.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "x"
            ]
          },
          "ref": "LM 12-mo checklist"
        },
        {
          "id": "st-el-box",
          "text": "Check the electronics box for water or damage.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "x"
            ]
          },
          "ref": "LM 12-mo checklist"
        }
      ]
    },
    {
      "module": "Scales",
      "items": [
        {
          "id": "st-sc-abr",
          "text": "Run the ABR scale test.",
          "when": {
            "pm": [
              "3",
              "6",
              "12"
            ],
            "model": [
              "s"
            ],
            "abr": [
              "yes"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-sc-cal-s",
          "text": "Confirm or calibrate the scales with a 100 g weight.",
          "when": {
            "model": [
              "s"
            ],
            "abr": [
              "yes"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "st-sc-cal-x",
          "text": "Confirm or calibrate the scales with a 100 g weight.",
          "when": {
            "model": [
              "x"
            ]
          },
          "ref": "LM checklist"
        }
      ]
    },
    {
      "module": "Close out",
      "items": [
        {
          "id": "st-co-form",
          "text": "Fill in the La Marzocco checklist for this visit: serial, voltage, group count and every reading. Get the customer's signature.",
          "ref": "LM checklist"
        }
      ]
    }
  ],
