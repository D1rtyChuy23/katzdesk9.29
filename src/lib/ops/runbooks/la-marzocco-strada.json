          "label": "8 mm silicone (H.3.007)"
        }
      ]
    }
  ],
  "banners": [
    {
      "tone": "ok",
      "text": "One kit per visit. The 3/9-month PM is the same visit at month 3 and month 9; the 6- and 12-month kits are complete for their visit, so earlier kits are not added."
    },
    {
      "when": {
        "pm": [
          "3"
        ]
      },
      "tone": "ok",
      "text": "3/9-month PM: La Marzocco lists loose parts for this visit, not a kit. Quantities are one per group."
    },
    {
      "when": {
        "model": [
          "x"
        ],
        "pm": [
          "6"
        ],
        "groups": [
          "3"
        ]
      },
      "tone": "warn",
      "text": "The 6-month checklist prints the 3-group kit as STRADA.X.63. It is listed here as STRADA.X.6.3; confirm with La Marzocco when ordering."
    }
  ],
