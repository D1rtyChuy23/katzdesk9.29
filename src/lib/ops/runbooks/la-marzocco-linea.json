{
  "id": "la-marzocco-linea",
  "manufacturer": "La Marzocco",
  "title": "Linea PM Runbook",
  "subtitle": "La Marzocco Linea Classic, Linea Classic S and Linea PB | preventive maintenance kits and steps",
  "sources": "La Marzocco USA preventative maintenance checklists v2.1 (May 2026): 3/9-month, 6-month and 12-month. Kit numbers are per visit and group count. La Marzocco does not print kit contents on the checklists; where a kit note lists contents it comes from the checklist's replace list or LM's annual PM summary. Confirm kit numbers with La Marzocco USA before ordering.",
  "storageKey": "lm-linea-runbook-v1",
  "models": [
    {
      "id": "classic",
      "label": "Linea Classic"
    },
    {
      "id": "classic-s",
      "label": "Linea Classic S"
    },
    {
      "id": "pb",
      "label": "Linea PB"
    }
  ],
  "intervals": [
    {
      "id": "3",
      "label": "3/9-month PM"
    },
    {
      "id": "6",
      "label": "6-month PM"
    },
    {
      "id": "12",
      "label": "12-month PM"
    }
  ],
  "options": [
    {
      "key": "groups",
      "label": "Groups",
      "default": "2",
      "choices": [
        {
          "val": "1",
          "label": "1 group"
        },
        {
          "val": "2",
          "label": "2 group"
        },
        {
          "val": "3",
          "label": "3 group"
        },
        {
          "val": "4",
          "label": "4 group"
        }
      ]
    },
    {
      "key": "ctrl",
      "label": "Brew control",
      "default": "av",
      "choices": [
        {
          "val": "av",
          "label": "AV (volumetric)"
        },
        {
          "val": "ee",
          "label": "EE (semi-auto)"
        },
        {
          "val": "mp",
          "label": "MP (paddle)"
        }
      ]
    },
    {
      "key": "scales",
      "label": "Integrated scales (ABR)",
      "default": "no",
      "when": {
        "model": [
          "pb"
        ]
      },
      "choices": [
        {
          "val": "no",
          "label": "No"
        },
        {
          "val": "yes",
          "label": "Yes"
        }
      ]
    }
  ],
  "banners": [
    {
      "tone": "ok",
      "text": "One kit per visit. The 3/9-month PM is the same visit at month 3 and month 9; the 6- and 12-month kits are complete for their visit, so earlier kits are not added."
    },
    {
      "when": {
        "model": [
          "pb"
        ],
        "groups": [
          "1"
        ]
      },
      "tone": "bad",
      "text": "Linea PB has no 1-group PM kit. Pick 2, 3 or 4 groups."
    },
    {
      "when": {
        "model": [
          "classic-s",
          "pb"
        ],
        "ctrl": [
          "mp"
        ]
      },
      "tone": "warn",
      "text": "MP is a Linea Classic option. Check the brew control on this unit."
    },
    {
      "when": {
        "model": [
          "classic"
        ]
      },
      "tone": "warn",
      "text": "Linea Classic: the checklist does not list the kit contents, and the MP valve rebuild (SA600/K2) is listed separately."
    }
  ],
