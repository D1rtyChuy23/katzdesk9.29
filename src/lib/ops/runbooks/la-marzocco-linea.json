  "steps": [
    {
      "module": "Water quality",
      "items": [
        {
          "id": "wq-test",
          "text": "Test the water before and after the filter with the LM test kit (F.9.000.01). Record the filter make and type and compare with the limits in Reference.",
          "ref": "LM checklist"
        }
      ]
    },
    {
      "module": "Group heads",
      "items": [
        {
          "id": "li-gh-gaskets",
          "text": "Replace the group gaskets and diffuser screens on every group (from the PM kit).",
          "when": {
            "model": [
              "classic-s",
              "pb"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "li-gh-kit",
          "text": "Fit the parts in the PM kit (the Linea Classic checklist does not list them).",
          "when": {
            "model": [
              "classic"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "li-gh-baskets",
          "text": "Check the filter baskets and springs.",
          "ref": "LM checklist"
        },
        {
          "id": "li-gh-buttons",
          "text": "Test every button.",
          "ref": "LM checklist"
        },
        {
          "id": "li-gh-res",
          "text": "Measure each flow meter's field resistance: 2.2 kΩ ±10% (1.98–2.42 kΩ). Record G1–G4 in kΩ.",
          "when": {
            "ctrl": [
              "av"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "li-gh-imp",
          "text": "Check the flow meter impellers.",
          "when": {
            "pm": [
              "12"
            ],
            "ctrl": [
              "av"
            ]
          },
          "ref": "LM 12-mo checklist"
        },
        {
          "id": "li-gh-vdc",
          "text": "Test the DC voltage at the control board (VDC).",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "classic"
            ],
            "ctrl": [
              "av"
            ]
          },
          "ref": "LM 12-mo checklist"
        },
        {
          "id": "li-gh-flow",
          "text": "Record each group's flow rate: grams in 30 s, G1–G4.",
          "ref": "LM checklist"
        },
        {
          "id": "li-gh-mp",
          "text": "Check the MP valves. Non-conical valves: rebuild with SA600/K2 if needed.",
          "when": {
            "pm": [
              "3",
              "6"
            ],
            "ctrl": [
              "mp"
            ]
          },
          "ref": "LM checklist"
        },
        {
          "id": "li-gh-mp12",
          "text": "Rebuild the non-conical MP valves (SA600/K2).",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "classic"
            ],
            "ctrl": [
              "mp"
            ]
          },
          "ref": "LM 12-mo checklist"
        }
      ]
    },
    {
      "module": "Boilers and pressure",
      "items": [
        {
          "id": "li-br-press",
          "text": "Record the brewing pressure (bar).",
          "ref": "LM checklist"
        },
        {
          "id": "li-br-exp",
          "text": "Check the expansion valve and record its maximum pressure (bar).",
          "ref": "LM checklist"
        },
        {
          "id": "li-br-temp",
          "text": "Record the coffee boiler temperature (°F).",
          "ref": "LM checklist"
        },
        {
          "id": "li-br-pstat",
          "text": "Check the steam boiler pressurestat.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "classic"
            ]
          },
          "ref": "LM 12-mo checklist"
        },
        {
          "id": "li-br-cont",
          "text": "Check the steam boiler contactor.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "classic"
            ]
          },
          "ref": "LM 12-mo checklist"
        },
        {
          "id": "li-br-psv",
          "text": "Replace the pressure safety valve.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "classic-s",
              "pb"
            ]
          },
          "ref": "LM 12-mo checklist"
        },
        {
          "id": "li-br-vb",
          "text": "Replace the vacuum breaker.",
          "when": {
            "pm": [
              "12"
            ],
            "model": [
              "classic-s",
              "pb"
            ]
          },
